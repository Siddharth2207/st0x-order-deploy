# Optional: WalletConnect Cloud project ID (https://cloud.walletconnect.com)
# Without this, only injected wallets (MetaMask etc.) will be available.
VITE_PUBLIC_WALLETCONNECT_ID=

# Turnkey credentials — server-only, read via $env/static/private.
# Never use VITE_ prefix here; these must NOT appear in the client bundle.
TURNKEY_ORG_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_SIGN_WITH=
